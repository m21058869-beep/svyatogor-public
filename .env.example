# Скопируйте файл и заполните значения:  cp .env.example .env
# Полный список читаемых переменных: server/env.ts

# --- Основное ---
# Порт приложения. Next.js читает PORT сам: `next dev` и `next start` слушают его.
PORT=3000

# NODE_ENV не задавайте: `next dev` выставляет development, `next build`/`next start` —
# production. Значение в этом файле может сломать сборку или рантайм.

# --- База данных (PostgreSQL, Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/svyatogor?schema=public

# --- Авторизация администратора ---
# Длинная случайная строка, например: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# true — cookie сессии передаётся только по HTTPS (в production обязательно true).
COOKIE_SECURE=false

# --- Загрузка изображений ---
# Максимальный размер загружаемого файла, МБ. Держите не меньше, чем
# client_max_body_size в Nginx (см. nginx.conf и TIMEWEB_DEPLOY.md): иначе
# тяжёлые пакеты фото будут отклоняться прокси раньше, чем приложением.
UPLOAD_MAX_MB=150

# --- Почта (форма обратной связи на странице «Контакты») ---
# Ящик, с которого уходят письма. Он же логин SMTP: почтовые сервисы (в том числе
# Timeweb) не пропускают письма, если From не совпадает с ящиком авторизации.
SMTP_USER=info@hksvyatogor.ru
# Пароль от ящика. Если в пароле есть символ `$`, экранируйте его или заключите
# значение в одинарные кавычки: Next.js раскрывает переменные внутри "..." и без кавычек.
SMTP_PASS="change-me"
# SMTP-сервер. По умолчанию — Timeweb: smtp.timeweb.ru, порт 465 (неявный TLS).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURE=true
# Куда приходят заявки с формы и имя отправителя в письме.
CONTACT_TO_EMAIL=info@hksvyatogor.ru
SMTP_FROM_NAME="ХК «Святогор»"

# --- S3-совместимое хранилище (Timeweb Object Storage / MinIO / AWS) ---
# Оставьте S3_ENDPOINT пустым для AWS S3.
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=my-bucket
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# true — path-style обращения к бакету (нужно для MinIO и большинства S3-совместимых).
S3_FORCE_PATH_STYLE=true
# Публичный URL, по которому отдаются картинки. Бакет указывать ОБЯЗАТЕЛЬНО, иначе все
# картинки отдают 404 — приложение подставляет ключ объекта прямо к этому значению:
#   path-style (при S3_FORCE_PATH_STYLE=true): https://<host>/<bucket>
#   virtual-host:                              https://<bucket>.<host>
# Пример (Timeweb Object Storage): S3_PUBLIC_URL="https://s3.twcstorage.ru/my-bucket"
S3_PUBLIC_URL=

# --- SEO (метаданные, robots.txt, sitemap.xml) ---
# Канонический адрес сайта. Подставляется в метаданные (metadataBase, превью
# OpenGraph), robots.txt и карту сайта — поисковикам нужны абсолютные ссылки.
# Указывайте без завершающего слэша. Для локальной разработки можно оставить
# значение по умолчанию — оно всё равно не попадает в индекс.
SITE_URL=https://hksvyatogor.ru
